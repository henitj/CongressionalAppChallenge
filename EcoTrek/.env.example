# EcoTrek app environment
# Copy this file to `.env` only when you need optional configuration.
# Leave values blank to keep the app local-first and use public map/trail/photo providers.
# Anything prefixed EXPO_PUBLIC_ is bundled into the client and must never contain a secret.

# ── Maps ─────────────────────────────────────────────────────────────────────
# The website and WebView APK use OpenStreetMap tiles and need no browser key.
# A separately built native Android/EAS app may use a restricted Google Maps key.
GOOGLE_MAPS_ANDROID_KEY=

# ── Optional backend ─────────────────────────────────────────────────────────
# URL of the EcoTrek API, not a database connection string or secret.
EXPO_PUBLIC_API_URL=

# ── Store listing details ────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
