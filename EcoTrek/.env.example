# ─────────────────────────────────────────────────────────────────────────────
# EcoTrek — app environment
#
# Copy this file to `.env` and fill in the values. Everything here is OPTIONAL:
# with an empty .env the app runs fully offline on the device, which is how it
# works today. Each variable you add switches on another piece.
#
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone
# who downloads it. Never put a database URL, an API secret, or a private key
# in this file. Those belong in server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sign-in ──────────────────────────────────────────────────────────────────
# There is no EcoTrek account sign-in in this build (Puter sign-in is separate). Profiles are local: a walk, a badge and a
# setting belong to the device they were made on, and nothing is uploaded.
#
# A Google flow used to sit behind a button on the sign-in screen. It needed
# OAuth client IDs from a Google Cloud project (below) that were never
# configured, so every tap ended in "sign-in is not set up yet". The button and
# the whole flow were removed rather than shipped broken; if a Google Cloud
# project is ever set up, `EcoTrek/src/context/AuthContext.tsx` is the one file
# that has to grow the provider back, and `docs/GOOGLE_OAUTH_SETUP.md` is still
# the walkthrough for creating the client IDs.
#
#   EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=...apps.googleusercontent.com
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=...apps.googleusercontent.com
#   EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=...apps.googleusercontent.com  (package com.ecotrek.app + release SHA-1)

# ── Maps ─────────────────────────────────────────────────────────────────────
# Website and downloadable WebView APK use bundled Leaflet + OpenStreetMap
# tiles. No browser map key is needed. Tiles need network; GPS also works with
# the route-only fallback. Native Android/EAS builds still use Google Maps:
# enable Maps SDK for Android and restrict the key by package + signing cert.
GOOGLE_MAPS_ANDROID_KEY=

# ── Online assistant ────────────────────────────────────────────────────────
# Puter-hosted Grok uses this default model; no application-owned key is needed.
# Users connect Puter in the assistant; account/credit limits may apply.
# The Connect/Test button checks a real reply before showing Connected.
# Override only if Puter changes the supported model name.
EXPO_PUBLIC_PUTER_GROK_MODEL=x-ai/grok-4.7

# ── Backend (Neon Postgres) ──────────────────────────────────────────────────
# Leave blank and the app stores everything on the device.
# Set it and clubs, activities and leaderboards sync across phones.
# This is the URL of YOUR API in server/, not the Neon connection string.
EXPO_PUBLIC_API_URL=

# ── Store listing details ────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# ── Help links shown in the app ──────────────────────────────────────────────
# Optional. The public page that walks users through getting an AI key (the
# website's /api-key page, e.g. https://your-site.example/api-key.html). When
# set, the assistant's settings sheet shows a tappable "Step-by-step guide"
# line so people can find a key without leaving the app.
EXPO_PUBLIC_API_KEY_GUIDE_URL=
