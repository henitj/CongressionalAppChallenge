# ─────────────────────────────────────────────────────────────────────────────
# EcoTrek — app environment
#
# Copy this file to `.env` and fill in the values. Everything here is OPTIONAL:
# with an empty .env the app runs fully offline on the device, which is how it
# works today. Each variable you add switches on another piece.
#
# Anything prefixed EXPO_PUBLIC_ is bundled into the app and readable by anyone
# who downloads it. Never put a database URL, an API secret, or a private key
# in this file. Those belong in server/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google sign-in ───────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Client IDs are public by design — safe to ship. Client SECRETS are not; the
# app never needs one.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# The Android client must be created with package name `com.ecotrek.app` and
# the SHA-1 of your RELEASE keystore (`eas credentials`). The debug SHA-1 will
# work in testing and then fail on the Play Store build.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# ── Android map ──────────────────────────────────────────────────────────────
# REQUIRED for the Android release build. Without it the map on the Track
# screen renders as a blank grey box. Free for mobile map display.
#   console.cloud.google.com → enable "Maps SDK for Android" → create API key
# No EXPO_PUBLIC_ prefix on purpose: this is read at build time by
# app.config.js and restricted to your app's package + signing certificate.
GOOGLE_MAPS_ANDROID_KEY=

# ── Backend (Neon Postgres) ──────────────────────────────────────────────────
# Leave blank and the app stores everything on the device.
# Set it and clubs, activities and leaderboards sync across phones.
# This is the URL of YOUR API in server/, not the Neon connection string.
EXPO_PUBLIC_API_URL=

# ── Store listing details ────────────────────────────────────────────────────
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
