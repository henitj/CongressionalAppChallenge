{
  "expo": {
    "name": "EcoTrek",
    "slug": "ecotrek",
    "scheme": "ecotrek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "primaryColor": "#1A7A5A",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A7A5A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecotrek.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EcoTrek uses your location while you are recording a walk or ride, so it can measure how far you go and show weather for where you are.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "EcoTrek keeps measuring your walk or ride if you lock your phone or switch apps. It only does this while a recording is running. When you tap Finish, it stops.",
        "UIBackgroundModes": ["location"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ecotrek.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A7A5A"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EcoTrek uses your location while you are recording to measure your distance and warn you about dangerous weather nearby.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1A7A5A",
          "defaultChannel": "ecotrek-reminders"
        }
      ],
      "expo-task-manager",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "EcoTrek uses your camera so you can take a picture of yourself for your profile photo.",
          "photosPermission": "EcoTrek uses your photo library so you can pick a picture of yourself for your profile photo."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
