# Required to start the optional API and read/write the Neon-backed catalogue.
# Use a pooled Neon connection string. Keep this server-side; never expose it in an app bundle.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional: comma-separated Google OAuth client IDs for protected legacy/cloud routes.
# The current app uses local guest profiles and does not initiate Google sign-in.
GOOGLE_CLIENT_IDS=

# Optional server-side trail-intelligence enrichment. There is no user-facing
# chatbot or free-form question endpoint. Keep this key server-side only.
# If unset, POST /api/trail-intel returns 501 and the app can use local catalogue facts.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

PORT=8787
# Restrict to the deployed app origin in production when possible.
CORS_ORIGIN=*
