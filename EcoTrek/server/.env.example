# ── Paste these two and the API works ────────────────────────────────────────

# Neon → your project → Connect → copy the connection string.
# Use the POOLED connection string (the one containing "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Comma-separated Google OAuth client IDs the API will accept tokens from.
# These are the same IDs you put in the app's .env — web, iOS and Android.
GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com

# ── Optional ─────────────────────────────────────────────────────────────────
PORT=8787
# Lock this down to your web origin in production instead of *
CORS_ORIGIN=*
